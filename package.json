{
  "name": "@peedief/template-engine",
  "version": "0.1.2",
  "description": "A minimal template engine supporting {{ variable }}, {% if %}, and {% for %} syntax patterns",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/peedief/template-engine.git"
  },
  "files": [
    "dist/",
    "README.MD",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ tests/ --ext .ts",
    "lint:fix": "eslint src/ tests/ --ext .ts --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "template",
    "templating",
    "engine",
    "html",
    "rendering"
  ],
  "author": "Claude Code Multi-Agent Team",
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.3.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  }
}
